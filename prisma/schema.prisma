generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AccountType {
  SCHOOL
  PARTNER
  COLLABORATOR
  CUSTOMER
  OTHER
}

enum AccountStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  PROPOSAL
  NEGOTIATION
  WAITING
  WON
  ACTIVE
  ON_HOLD
  LOST
  CLOSED
}

enum TaskStatus {
  OPEN
  DOING
  WAITING
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum OpportunityStatus {
  LEAD
  QUALIFIED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  name        String
  region      String?
  status      UserStatus  @default(ACTIVE)
  managerId   String?
  manager     User?       @relation("Manager", fields: [managerId], references: [id])
  reports     User[]      @relation("Manager")
  roles       UserRole[]
  accounts    Account[]   @relation("AccountOwner")
  tasks       Task[]      @relation("TaskOwner")
  updates     Update[]
  reportsWeek WeeklyReport[]
  auditLogs   AuditLog[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Role {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  validFrom DateTime @default(now())
  validTo   DateTime?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Account {
  id              String        @id @default(cuid())
  name            String
  type            AccountType
  province        String?
  district        String?
  schoolSector    String?
  ownerId         String?
  owner           User?         @relation("AccountOwner", fields: [ownerId], references: [id])
  currentStatus   AccountStatus @default(NEW)
  currentModel    String?
  potentialModel  String?
  nextAction      String?
  nextActionDate  DateTime?
  debtAmount      Decimal?      @db.Decimal(15,2)
  assetStatus     String?
  contacts        Contact[]
  opportunities   Opportunity[]
  tasks           Task[]
  updates         Update[]
  receivables     Receivable[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([ownerId, currentStatus])
}

model Contact {
  id              String   @id @default(cuid())
  accountId       String
  name            String
  title           String?
  phone           String?
  email           String?
  isDecisionMaker Boolean  @default(false)
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id             String            @id @default(cuid())
  accountId      String
  name           String
  product        String
  status         OpportunityStatus @default(LEAD)
  estimatedValue Decimal?          @db.Decimal(15,2)
  probability    Int?
  source         String?
  nextAction     String?
  nextActionDate DateTime?
  account        Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Task {
  id           String      @id @default(cuid())
  title        String
  ownerId      String
  accountId    String?
  category     String
  priority     Priority    @default(MEDIUM)
  status       TaskStatus  @default(OPEN)
  dueDate      DateTime?
  nextAction   String?
  nextActionAt DateTime?
  ceoRequired  Boolean     @default(false)
  ceoRequest   String?
  completedAt  DateTime?
  owner        User        @relation("TaskOwner", fields: [ownerId], references: [id])
  account      Account?    @relation(fields: [accountId], references: [id])
  updates      Update[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@index([ownerId, status, dueDate])
}

model Update {
  id             String   @id @default(cuid())
  userId         String
  accountId      String?
  taskId         String?
  category       String
  result         String
  previousStatus String?
  newStatus      String?
  nextAction     String
  deadline       DateTime
  importance     String
  ceoRequired    Boolean  @default(false)
  ceoRequest     String?
  evidenceUrl    String?
  user           User     @relation(fields: [userId], references: [id])
  account        Account? @relation(fields: [accountId], references: [id])
  task           Task?    @relation(fields: [taskId], references: [id])
  createdAt      DateTime @default(now())
  @@index([userId, createdAt])
}

model Receivable {
  id          String   @id @default(cuid())
  accountId   String
  amount      Decimal  @db.Decimal(15,2)
  dueDate     DateTime?
  expectedAt  DateTime?
  status      String
  missingDocs String?
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyReport {
  id                 String   @id @default(cuid())
  userId             String
  weekStart          DateTime
  weekEnd            DateTime
  keyResults         Json
  importantChanges   Json
  openIssues         Json
  nextWeekPriorities Json
  staffComment       String?
  submittedAt        DateTime?
  user               User     @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([userId, weekStart])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}
